{
  "private": "true",
  "scripts": {
    "Incremental Development Building": "rimraf --glob 02-LocalDevelopmentBuild/* && yda build --mode LOCAL_DEVELOPMENT",
    "Production Building": "rimraf --glob 03-ProductionBuild/* && yda build --mode PRODUCTION",
    "Distributable Packing": "rimraf --glob \"../docs/**/!(CNAME)\" && cpy 03-ProductionBuild/** ../docs && cd ../docs && git add .",
    "Page Creating": "tsx Automation/TemplatesGenerator.ts",
    "dev": "npm run \"Incremental Development Building\"",
    "prod": "npm run \"Production Building\"",
    "dist": "npm run \"Distributable Packing\""
  },
